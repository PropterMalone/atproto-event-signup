{
	"name": "atproto-event-signup",
	"version": "0.1.0",
	"private": true,
	"license": "MIT",
	"description": "Self-hosted event signup with Bluesky OAuth and private SQLite storage",
	"type": "module",
	"engines": {
		"node": ">=22.16.0"
	},
	"scripts": {
		"dev": "tsx src/server/main.ts",
		"build": "tsc -p tsconfig.build.json && esbuild src/browser/main.ts --bundle --format=esm --target=es2022 --outfile=dist/public/app.js && node scripts/copy-public.mjs",
		"start": "node --env-file-if-exists=.env dist/server/main.js",
		"smoke": "node scripts/smoke.mjs",
		"backup": "node --env-file-if-exists=.env scripts/backup.mjs",
		"test": "vitest run --passWithNoTests",
		"test:coverage": "vitest run --coverage --passWithNoTests",
		"typecheck": "tsc --noEmit",
		"check": "biome check --write .",
		"deadcode": "knip && ts-prune --error",
		"validate": "biome ci . && npm run typecheck && npm run test:coverage && npm run deadcode"
	},
	"dependencies": {
		"@atproto-labs/fetch-node": "0.4.3",
		"@atproto/oauth-client-node": "0.5.12"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.15",
		"@types/node": "22.20.5",
		"@vitest/coverage-v8": "5.0.5",
		"esbuild": "0.28.2",
		"happy-dom": "21.0.4",
		"knip": "6.43.0",
		"ts-prune": "0.10.3",
		"tsx": "4.23.15",
		"typescript": "5.9.3",
		"vitest": "5.0.5"
	}
}
