# Copy to .env locally. Never commit .env or runtime data.
APP_ORIGIN=http://127.0.0.1:3000
PORT=3000
DATA_DIR=.data
BACKUP_DIR=.backups
# Comma-separated verified account DIDs. Empty = no operator access.
# Resolve YOUR account's DID before setting this; do not use somebody else's.
ADMIN_DIDS=
# For production set APP_ORIGIN to your own exact HTTPS origin.
# Optional response and print-request cutoffs (ISO timestamps with explicit timezone):
# RESPONSE_CUTOFF=
# BUTTON_CUTOFF=
# Choose an artwork deletion deadline for YOUR event before HTTPS startup or backups.
# This illustrative value is NOT a recommendation for your retention policy.
ARTWORK_DELETE_AT=2027-01-31T23:59:59Z
# Enable ONLY behind a trusted loopback proxy that overwrites the secret header.
# TRUST_CLOUDFLARE_TUNNEL=true
# CLOUDFLARE_ORIGIN_SECRET=
# Visible face, not the paper-cut size. Measure/test actual hardware first.
PRINT_FACE_DIAMETER_MM=58
# Export remains disabled until an explicit tested cut diameter is set.
# PRINT_CUT_DIAMETER_MM=
